# ================================
# Stock Daily - Production Environment
# ================================
# IMPORTANT: Copy this file to .env and update ALL values before deployment!

# ================================
# Database Configuration
# ================================
# Use strong, unique passwords in production!
POSTGRES_USER=stockuser
POSTGRES_PASSWORD=CHANGE_THIS_TO_A_STRONG_PASSWORD_123!
POSTGRES_DB=stockdaily

# ================================
# Backend Configuration
# ================================
NODE_ENV=production

# CRITICAL: Generate a secure random string for JWT_SECRET
# You can use: openssl rand -base64 64
JWT_SECRET=CHANGE_THIS_TO_A_SECURE_RANDOM_STRING_AT_LEAST_64_CHARS

# Token expiration (e.g., 7d, 24h, 1h)
JWT_EXPIRES_IN=7d

# ================================
# External API Configuration
# ================================
# 东方财富 API Token (用于股票搜索)
# 默认值可用，如需更换请联系东方财富获取新 token
EASTMONEY_API_TOKEN=D43BF722C8E33BDC906FB84D85E326E8

# ================================
# Frontend Configuration
# ================================
# Port to expose frontend (use 80 for HTTP, 443 for HTTPS with reverse proxy)
FRONTEND_PORT=80

# CORS origin - should match your domain
# Examples:
#   - http://localhost (development)
#   - https://stock.example.com (production with domain)
CORS_ORIGIN=http://localhost

# ================================
# Optional: SSL/TLS Configuration
# ================================
# If using HTTPS, uncomment and configure:
# SSL_CERT_PATH=/path/to/cert.pem
# SSL_KEY_PATH=/path/to/key.pem

# ================================
# Optional: Backup Configuration
# ================================
# BACKUP_DIR=/path/to/backups
# BACKUP_RETENTION_DAYS=30
