// prisma/schema.prisma

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id        String   @id @default(uuid())
  email     String   @unique
  password  String
  username  String
  twoFactorSecret  String?
  twoFactorEnabled Boolean @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  diaries   Diary[]
  tags      Tag[]
  tradingAccounts TradingAccount[]
  positions   Position[]
  priceAlerts PriceAlert[]
  watchlists  Watchlist[]
  watchlistGroups WatchlistGroup[]
  earningsCalendars EarningsCalendar[]
  tradeSignals TradeSignal[]
  settings    UserSettings?
  goals       InvestmentGoal[]
  learningNotes LearningNote[]
  dividendRecords DividendRecord[]
  calendarEvents CalendarEvent[]
  simulatedTrades SimulatedTrade[]
  simulatedAccount SimulatedAccount?
  costRecords CostRecord[]
  tradingJournals TradingJournal[]
  strategyTemplates StrategyTemplate[]
  tradePlanTemplates TradePlanTemplate[]
  tradeReviewTemplates TradeReviewTemplate[]
}

// 交易账户模型
model TradingAccount {
  id          String   @id @default(uuid())
  userId      String
  name        String   // 账户名称，如"主账户"、"打新账户"
  broker      String?  // 券商名称
  accountNo   String?  // 账户号（可选，脱敏存储）
  initialAssets Decimal? // 初始资金
  currentAssets Decimal? // 当前资产
  isDefault   Boolean  @default(false) // 是否默认账户
  isActive    Boolean  @default(true)  // 是否启用
  color       String   @default("#1890FF") // 账户颜色标识
  notes       String?  // 备注
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user User @relation(fields: [userId], references: [id])

  @@unique([userId, name])
}

model Diary {
  id                String        @id @default(uuid())
  userId            String
  date              DateTime      @unique
  marketTrend       MarketTrend?
  marketVolume      MarketVolume?
  marketComment     String?
  hotSectors        String[]
  profitLossAmount  Decimal?
  profitLossPercent Decimal?
  totalAssets       Decimal?
  reflectionGood    String?
  reflectionBad     String?
  reflectionImprove String?
  reflectionTags    String[]
  emotionBefore     Emotion?
  emotionDuring     Emotion?
  emotionAfter      Emotion?
  emotionNote       String?
  learningNote      String?
  learningCategory  LearningCategory?
  riskNotes         String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  user        User         @relation(fields: [userId], references: [id])
  trades      Trade[]
  watchStocks WatchStock[]
  buyPlans    BuyPlan[]
  sellPlans   SellPlan[]
  stopLosses  StopLoss[]

  @@index([userId, date])
}

model Trade {
  id          String         @id @default(uuid())
  diaryId     String
  stockCode   String
  stockName   String
  direction   TradeDirection
  price       Decimal
  quantity    Int
  amount      Decimal
  reason      String?
  strategyTag String?
  createdAt   DateTime       @default(now())

  diary Diary @relation(fields: [diaryId], references: [id], onDelete: Cascade)

  @@index([diaryId])
  @@index([stockCode])
}

model WatchStock {
  id           String     @id @default(uuid())
  diaryId      String
  stockCode    String
  stockName    String
  watchReason  String?
  watchLevel   WatchLevel @default(NORMAL)
  techPosition String?
  createdAt    DateTime   @default(now())

  diary Diary @relation(fields: [diaryId], references: [id], onDelete: Cascade)
}

model BuyPlan {
  id               String   @id @default(uuid())
  diaryId          String
  stockCode        String
  stockName        String
  targetPrice      Decimal
  positionPercent  Decimal
  buyReason        String?
  triggerCondition String?
  createdAt        DateTime @default(now())

  diary Diary @relation(fields: [diaryId], references: [id], onDelete: Cascade)
}

model SellPlan {
  id               String   @id @default(uuid())
  diaryId          String
  stockCode        String
  stockName        String
  targetPrice      Decimal
  sellPercent      Decimal
  sellReason       String?
  triggerCondition String?
  createdAt        DateTime @default(now())

  diary Diary @relation(fields: [diaryId], references: [id], onDelete: Cascade)
}

model StopLoss {
  id         String   @id @default(uuid())
  diaryId    String
  stockCode  String
  stockName  String
  stopPrice  Decimal
  costPrice  Decimal?
  stopReason String?
  createdAt  DateTime @default(now())

  diary Diary @relation(fields: [diaryId], references: [id], onDelete: Cascade)
}

model Tag {
  id         String      @id @default(uuid())
  userId     String
  name       String
  color      String      @default("#1890FF")
  category   TagCategory
  usageCount Int         @default(0)
  createdAt  DateTime    @default(now())

  user User @relation(fields: [userId], references: [id])

  @@unique([userId, name])
}

// 持仓记录
model Position {
  id          String   @id @default(uuid())
  userId      String
  stockCode   String
  stockName   String
  quantity    Int      // 持仓数量
  costPrice   Decimal  // 成本价
  totalCost   Decimal  // 总成本
  targetPrice Decimal? // 目标价
  stopPrice   Decimal? // 止损价
  industry    String?  // 行业板块
  notes       String?  // 备注
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user        User         @relation(fields: [userId], references: [id])
  priceAlerts PriceAlert[]

  @@unique([userId, stockCode])
}

// 自选股列表
model Watchlist {
  id          String   @id @default(uuid())
  userId      String
  stockCode   String
  stockName   String
  groupId     String?  // 分组ID
  industry    String?  // 行业板块
  addPrice    Decimal? // 添加时价格
  targetPrice Decimal? // 目标价
  stopPrice   Decimal? // 止损价
  notes       String?  // 备注
  sortOrder   Int      @default(0) // 排序
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user  User            @relation(fields: [userId], references: [id])
  group WatchlistGroup? @relation(fields: [groupId], references: [id], onDelete: SetNull)

  @@unique([userId, stockCode])
  @@index([userId, sortOrder])
  @@index([userId, groupId])
}

// 自选股分组
model WatchlistGroup {
  id        String   @id @default(uuid())
  userId    String
  name      String
  color     String   @default("#1890FF")
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user       User        @relation(fields: [userId], references: [id])
  watchlists Watchlist[]

  @@unique([userId, name])
  @@index([userId, sortOrder])
}

// 财报日历
model EarningsCalendar {
  id            String   @id @default(uuid())
  userId        String
  stockCode     String
  stockName     String
  reportDate    DateTime // 财报发布日期
  reportType    String   // 年报/半年报/季报
  isNotified    Boolean  @default(false) // 是否已通知
  notes         String?  // 备注
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  user User @relation(fields: [userId], references: [id])

  @@index([userId, reportDate])
}

// 交易信号
model TradeSignal {
  id          String      @id @default(uuid())
  userId      String
  stockCode   String
  stockName   String
  signalType  SignalType  // 信号类型
  indicator   String      // 指标名称 (MA, MACD, KDJ等)
  direction   SignalDirection // 买入/卖出信号
  price       Decimal     // 触发价格
  description String?     // 信号描述
  isRead      Boolean     @default(false) // 是否已读
  triggeredAt DateTime    @default(now()) // 触发时间
  createdAt   DateTime    @default(now())

  user User @relation(fields: [userId], references: [id])

  @@index([userId, isRead, triggeredAt])
}

// 信号类型
enum SignalType {
  MA_CROSS      // 均线交叉
  MACD_CROSS    // MACD交叉
  KDJ_SIGNAL    // KDJ信号
  RSI_SIGNAL    // RSI超买超卖
  VOLUME_BREAK  // 放量突破
  PRICE_BREAK   // 价格突破
  CUSTOM        // 自定义
}

// 信号方向
enum SignalDirection {
  BUY   // 买入信号
  SELL  // 卖出信号
}

// 价格提醒
model PriceAlert {
  id          String     @id @default(uuid())
  userId      String
  positionId  String?    // 关联持仓（可选）
  stockCode   String
  stockName   String
  alertType   AlertType  // 提醒类型
  targetPrice Decimal    // 目标价格
  isTriggered Boolean    @default(false) // 是否已触发
  isEnabled   Boolean    @default(true)  // 是否启用
  notes       String?    // 备注
  triggeredAt DateTime?  // 触发时间
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  user     User      @relation(fields: [userId], references: [id])
  position Position? @relation(fields: [positionId], references: [id], onDelete: SetNull)

  @@index([userId, isEnabled, isTriggered])
}

// 提醒类型
enum AlertType {
  TAKE_PROFIT  // 止盈
  STOP_LOSS    // 止损
  PRICE_ABOVE  // 价格高于
  PRICE_BELOW  // 价格低于
}

// Enums
enum MarketTrend {
  SURGE  // 大涨
  RISE   // 小涨
  FLAT   // 平盘
  DROP   // 小跌
  PLUNGE // 大跌
}

enum MarketVolume {
  HIGH   // 放量
  LOW    // 缩量
  NORMAL // 平量
}

enum TradeDirection {
  BUY
  SELL
}

enum WatchLevel {
  HIGH   // 重点关注
  NORMAL // 一般关注
  LOW    // 观察
}

enum Emotion {
  EXCITED // 兴奋
  CALM    // 平静
  ANXIOUS // 焦虑
  FEARFUL // 恐惧
  GREEDY  // 贪婪
}

enum LearningCategory {
  TECHNICAL   // 技术分析
  FUNDAMENTAL // 基本面
  PSYCHOLOGY  // 交易心理
  MARKET      // 市场规律
  OTHER       // 其他
}

enum TagCategory {
  STRATEGY   // 策略标签
  SECTOR     // 板块标签
  REFLECTION // 反思标签
  CUSTOM     // 自定义
}

// 用户设置
model UserSettings {
  id              String   @id @default(uuid())
  userId          String   @unique
  dashboardLayout Json?    // 仪表盘布局
  screenFilters   Json?    // 股票筛选条件
  compareStocks   String[] // 对比股票代码
  gridCalculator  Json?    // 网格计算器数据
  dipCalculator   Json?    // 定投计算器数据
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  user User @relation(fields: [userId], references: [id])
}

// 投资目标
model InvestmentGoal {
  id          String   @id @default(uuid())
  userId      String
  title       String
  targetValue Decimal
  currentValue Decimal @default(0)
  deadline    DateTime?
  category    String   // profit/asset/winrate/trades
  isCompleted Boolean  @default(false)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user User @relation(fields: [userId], references: [id])

  @@index([userId])
}

// 学习笔记
model LearningNote {
  id        String   @id @default(uuid())
  userId    String
  title     String
  content   String
  category  String   // technical/fundamental/psychology/strategy
  tags      String[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id])

  @@index([userId, category])
}

// 分红记录
model DividendRecord {
  id           String   @id @default(uuid())
  userId       String
  stockCode    String
  stockName    String
  exDate       DateTime // 除权除息日
  dividendType String   // cash/stock
  amount       Decimal  // 每股分红金额或送股比例
  shares       Int?     // 持股数量
  totalAmount  Decimal? // 总分红金额
  notes        String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  user User @relation(fields: [userId], references: [id])

  @@index([userId, exDate])
}

// 日历事件
model CalendarEvent {
  id          String   @id @default(uuid())
  userId      String
  date        DateTime
  title       String
  eventType   String   // earnings/dividend/ipo/meeting/custom
  description String?
  stockCode   String?
  stockName   String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user User @relation(fields: [userId], references: [id])

  @@index([userId, date])
}

// 模拟交易
model SimulatedTrade {
  id        String   @id @default(uuid())
  userId    String
  stockName String
  tradeType String   // buy/sell
  price     Decimal
  quantity  Int
  amount    Decimal
  balance   Decimal  // 交易后余额
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id])

  @@index([userId, createdAt])
}

// 模拟账户
model SimulatedAccount {
  id            String   @id @default(uuid())
  userId        String   @unique
  initialBalance Decimal @default(100000)
  currentBalance Decimal @default(100000)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  user User @relation(fields: [userId], references: [id])
}

// 成本计算记录
model CostRecord {
  id        String   @id @default(uuid())
  userId    String
  tradeType String   // buy/sell
  price     Decimal
  quantity  Int
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id])

  @@index([userId])
}

// 交易日志
model TradingJournal {
  id                String   @id @default(uuid())
  userId            String
  date              DateTime @db.Date
  marketObservation String   @db.Text
  tradingThoughts   String   @db.Text
  lessonsLearned    String   @db.Text
  emotionScore      Int      @default(3)
  tags              String[]
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  user User @relation(fields: [userId], references: [id])

  @@unique([userId, date])
  @@index([userId])
}

// 策略模板
model StrategyTemplate {
  id          String   @id @default(uuid())
  userId      String?  // null 表示系统预设
  name        String
  description String?
  category    String   // trend/reversal/breakout/grid
  params      Json     // 策略参数
  isPublic    Boolean  @default(false)
  usageCount  Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user User? @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([category])
}

// 独立交易计划
model TradePlanTemplate {
  id            String   @id @default(uuid())
  userId        String
  stockCode     String
  stockName     String
  direction     String   // buy/sell
  entryPrice    Decimal
  targetPrice   Decimal
  stopPrice     Decimal
  positionSize  Int?     // 计划仓位百分比
  reason        String?  @db.Text
  status        String   @default("pending") // pending/executed/cancelled
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  user User @relation(fields: [userId], references: [id])

  @@index([userId, status])
}

// 交易复盘模板
model TradeReviewTemplate {
  id              String   @id @default(uuid())
  userId          String
  date            DateTime @db.Date
  stockCode       String
  stockName       String
  tradeType       String   // buy/sell
  entryReason     String?  @db.Text
  exitReason      String?  @db.Text
  marketCondition String?  @db.Text
  emotionState    Int?     // 1-5
  lessonsLearned  String?  @db.Text
  improvement     String?  @db.Text
  rating          Int      // 1-5
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  user User @relation(fields: [userId], references: [id])

  @@index([userId, date])
}
